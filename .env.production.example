# Warden production env template for Postgres.

NODE_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME

# Required secrets/credentials.
WARDEN_MASTER_KEY=
CELO_RPC_URL=
CELO_MAINNET_RPC_URL=
CELO_SEPOLIA_RPC_URL=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
WARDEN_PUBLIC_URL=
OPENAI_API_KEY=
WARDEN_AI_RISK_MODEL=gpt-5.4-mini
WARDEN_AGENT_CHAT_MODEL=gpt-5.4-mini

# Hosted Warden x402 SDK provider API at /api/x402.
WARDEN_X402_PAY_TO=
WARDEN_X402_FACILITATOR_URL=
WARDEN_X402_NETWORK=eip155:11142220
WARDEN_X402_ASSET=0x01C5C0122039549AD1493B8220cABEdD739BC44E
FAL_KEY=
FISH_API_KEY=
FISH_AUDIO_VOICE_ID=
EXA_API_KEY=
TAVILY_API_KEY=
ALCHEMY_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
RESEND_TEST_TO=
