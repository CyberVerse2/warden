# Warden production env template for Postgres.

NODE_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME

# Required secrets/credentials.
WARDEN_MASTER_KEY=
SOLANA_RPC_URL=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
OPENAI_API_KEY=
WARDEN_AI_RISK_MODEL=gpt-5.4-mini
WARDEN_SMOKE_AGENT_TOKEN=
WARDEN_SMOKE_X402_URL=
WARDEN_SMOKE_METHOD=GET
WARDEN_SMOKE_BODY=
