# Warden production env template for file-backed SQLite.
#
# Keep the SQLite file outside the deployed app directory so code deploys do not
# overwrite production state.

NODE_ENV=production
WARDEN_APP_ROOT=/srv/warden/app
DATABASE_URL=file:/var/lib/warden/warden.db

# Required secrets/credentials.
WARDEN_MASTER_KEY=
SOLANA_RPC_URL=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
