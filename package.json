{
  "name": "warden",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "smoke:workflow": "pnpm --filter @warden/mcp exec tsx ../../scripts/smoke-workflow.ts",
    "register:8004": "pnpm --filter @warden/mcp exec tsx ../../scripts/register-erc8004-celo.ts",
    "db:push": "turbo run db:push --filter=@warden/db",
    "db:studio": "turbo run db:studio --filter=@warden/db"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "@solana/kit": "6.9.0"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
