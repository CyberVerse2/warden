  "devDependencies": {
    "@types/node": "^25.6.2",
    "turbo": "^2.9.11",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
