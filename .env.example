# --- Required ----------------------------------------------------------------

# Master key used to derive per-wallet AES-256-GCM keys via HKDF.
# Generate with: openssl rand -base64 32
WARDEN_MASTER_KEY=

# Postgres database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/warden

# Default Solana RPC endpoint used for wallet balance reads and devnet x402.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Network-specific RPC endpoints used when building x402 payment proofs.
# Leave mainnet blank to let the x402 SDK use its default public mainnet RPC.
SOLANA_MAINNET_RPC_URL=https://fittest-alpha-grass.solana-mainnet.quiknode.pro/e637f5f5f16f7ca39b731968cf0cacf0b36792e2/
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_TESTNET_RPC_URL=

# Privy app credentials (https://dashboard.privy.io). Required for production
# auth; in dev you can skip these and use WARDEN_ALLOW_DEV_AUTH=1 instead.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Public app origin used when generating hosted MCP URLs.
WARDEN_PUBLIC_URL=http://localhost:3000

# AI model access. Warden uses one model for x402 risk review and one for the
# hosted agent chat demo that plans MCP tool calls.
OPENAI_API_KEY=
WARDEN_AI_RISK_MODEL=gpt-5.4-mini
WARDEN_AGENT_CHAT_MODEL=gpt-5.4-mini

# Live workflow smoke test. Use a funded, disposable smoke agent token and a
# real x402 endpoint; this will make a real paid request.
WARDEN_SMOKE_AGENT_TOKEN=
WARDEN_SMOKE_AGENT_ID=
WARDEN_SMOKE_X402_URL=
WARDEN_SMOKE_DISCOVERY_QUERY=x402 devnet
WARDEN_SMOKE_METHOD=GET
WARDEN_SMOKE_BODY=

# --- Local dev only ----------------------------------------------------------

# Bypass Privy and authenticate as a stub operator. Has no effect when
# NODE_ENV=production.
WARDEN_ALLOW_DEV_AUTH=1
DEV_OPERATOR_USER_ID=usr_dev_operator
DEV_OPERATOR_EMAIL=operator@warden.local

# --- MCP server (apps/mcp) ---------------------------------------------------
# Only needed when running the stdio MCP server directly. The web app's hosted
# MCP endpoint at /api/mcp/[agentId] reads the token from the Authorization
# header and does not need these env vars.

# Bearer token of the agent this MCP server speaks for. Get one from the
# token reveal page after creating or rotating an agent.
WARDEN_AGENT_TOKEN=
