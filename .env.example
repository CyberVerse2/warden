# --- Required ----------------------------------------------------------------

# Master key used to derive per-wallet AES-256-GCM keys via HKDF.
# Generate with: openssl rand -base64 32
WARDEN_MASTER_KEY=

# libSQL database. Local/dev can use a repo-local file path. Production uses
# Warden's SQLite file outside the app folder on persistent storage.
DATABASE_URL=file:/var/lib/warden/warden.db

# Optional but recommended in production: the deployed application directory.
# Used to reject accidental DATABASE_URL paths inside the app folder.
WARDEN_APP_ROOT=/srv/warden/app

# Solana RPC endpoint.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Coinbase x402 facilitator. Required for any payment to actually settle.
# Devnet: https://x402.org/facilitator
COINBASE_X402_FACILITATOR_URL=https://x402.org/facilitator

# Privy app credentials (https://dashboard.privy.io). Required for production
# auth; in dev you can skip these and use WARDEN_ALLOW_DEV_AUTH=1 instead.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Local dev only ----------------------------------------------------------

# Bypass Privy and authenticate as a stub operator. Has no effect when
# NODE_ENV=production.
WARDEN_ALLOW_DEV_AUTH=1
DEV_OPERATOR_USER_ID=usr_dev_operator
DEV_OPERATOR_EMAIL=operator@warden.local

# --- MCP server (apps/mcp) ---------------------------------------------------
# Only needed when running the stdio MCP server directly. The web app's hosted
# MCP endpoint at /api/mcp/[agentId] reads the token from the Authorization
# header and does not need these env vars.

# Bearer token of the agent this MCP server speaks for. Get one from the
# token reveal page after creating or rotating an agent.
WARDEN_AGENT_TOKEN=
