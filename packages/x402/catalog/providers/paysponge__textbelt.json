                "SENT",
                "SENDING",
                "FAILED",
                "UNKNOWN"
              ],
              "description": "Carrier-reported delivery status."
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "X402PaymentRequired": {
          "type": "object",
          "properties": {
            "x402Version": {
              "type": "integer",
              "const": 2
            },
            "error": {
              "type": "string"
